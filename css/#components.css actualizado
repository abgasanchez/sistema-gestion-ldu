.app-shell{display:flex;min-height:100vh}.sidebar{width:252px;background:var(--navy);color:#fff;padding:20px 14px;display:flex;flex-direction:column}.brand{display:flex;gap:10px;align-items:center;padding:8px 10px 26px}.brand-mark{background:linear-gradient(135deg,#22d3ee,#2563eb);border-radius:10px;padding:10px;font-weight:800}.brand small,.brand strong{display:block}.brand small{color:#c7d2fe;font-size:11px;margin-top:3px}.nav-group{color:#93a4d8;font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin:18px 10px 6px}.nav-item{display:block;width:100%;border:0;background:transparent;color:#e0e7ff;text-align:left;padding:11px 12px;border-radius:9px;cursor:pointer}.nav-item:hover,.nav-item.active{background:#263777}.sidebar-footer{margin-top:auto;color:#a5b4fc;font-size:11px;padding:10px}.main-content{flex:1;min-width:0}.topbar{background:linear-gradient(100deg,#244398,#1d9de0);color:#fff;padding:16px 28px;display:flex;justify-content:space-between;align-items:center}.eyebrow{font-size:10px;letter-spacing:.12em;margin:0 0 4px;color:#dbeafe}.topbar h1{font-size:23px;margin:0}.status-pill{background:#ffffff26;border:1px solid #ffffff66;padding:7px 10px;border-radius:999px;font-size:12px}.page{padding:24px;max-width:1600px;margin:auto}.section{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 7px 24px #1e3a8a0b;margin-bottom:18px}.section-head{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid var(--line)}.section-head h2{font-size:16px;margin:0}.section-body{padding:18px}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}.metric{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:16px}.metric strong{display:block;font-size:26px}.metric span{color:var(--muted);font-size:12px}.toolbar{display:flex;gap:10px;flex-wrap:wrap}.input,.select{border:1px solid var(--line);border-radius:9px;padding:10px 12px;background:#fff;color:var(--text)}.input{min-width:240px}.btn{border:0;border-radius:9px;padding:10px 14px;background:var(--blue);color:#fff;font-weight:700;cursor:pointer}.btn.secondary{background:#e8eef9;color:var(--text)}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:900px}th,td{text-align:left;padding:11px 12px;border-bottom:1px solid var(--line);font-size:12px;white-space:nowrap}th{color:#475569;background:#f8fafc;font-size:11px;text-transform:uppercase}.badge{display:inline-flex;padding:5px 8px;border-radius:999px;font-size:11px;font-weight:700}.badge.green{background:#d1fae5;color:#047857}.badge.red{background:#fee2e2;color:#b91c1c}.badge.orange{background:#ffedd5;color:#c2410c}.badge.blue{background:#dbeafe;color:#1d4ed8}.badge.gray{background:#e2e8f0;color:#475569}.empty,.loading{padding:36px;text-align:center;color:var(--muted)}.error{color:var(--red);padding:12px}.drawer{position:fixed;inset:0;background:#0f172a66;display:flex;justify-content:flex-end}.drawer-card{background:#fff;width:min(560px,100%);height:100%;padding:24px;overflow:auto}.detail-row{padding:10px 0;border-bottom:1px solid var(--line)}.detail-row b{display:block;font-size:11px;color:var(--muted);text-transform:uppercase}
.dashboard-overview{grid-template-columns:repeat(5,minmax(0,1fr))}.dashboard-module .compact{grid-template-columns:repeat(10,minmax(100px,1fr));padding:14px;margin:0}.dashboard-module .metric{padding:12px;text-align:center}.dashboard-module .metric strong{font-size:20px}.dashboard-bottom{display:grid;grid-template-columns:1fr 1fr;gap:18px}.dashboard-module.blue{border-top:4px solid #2563eb}.dashboard-module.a{border-top:4px solid #2563eb}.dashboard-module.b{border-top:4px solid #f97316}
