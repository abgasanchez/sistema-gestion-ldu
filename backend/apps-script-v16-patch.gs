  appendObject_(LDU.SHEETS.NOTIFICATIONS,r);return ok_(Object.assign({},r,{timestamp:r.fecha,type:r.tipo,subject:r.asunto,recipient:r.destinatario,email:r.correo,sender:r.remitente,status:r.estado,role:r.rol}));
