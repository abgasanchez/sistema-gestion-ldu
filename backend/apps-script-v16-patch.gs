/* v49: limpieza segura y específica de Stock Mod. A/B. */
function clearSheet(p){p=p||{};var key=String(p.sheetKey||'').toUpperCase();if(key!=='STOCK_A'&&key!=='STOCK_B')return clearSheetBase_(p);if(String(p.confirmation||'')!=='LIMPIAR '+key)return fail_('Confirmación de limpieza inválida.','CONFIRMATION_REQUIRED');if(String(p.userId||'').toLowerCase()!=='admin')return fail_('Solo el administrador puede ejecutar limpiezas.','ADMIN_REQUIRED');var lock=LockService.getScriptLock();try{lock.waitLock(30000);var ss=SpreadsheetApp.openById(LDU.SPREADSHEET_ID),sh=ss.getSheetByName(LDU.SHEETS.STOCK),modelSheet=ss.getSheetByName(key==='STOCK_A'?LDU.SHEETS.MODELS_A:LDU.SHEETS.MODELS_B);if(!sh)return fail_('La hoja configurada no existe: '+LDU.SHEETS.STOCK,'SHEET_NOT_FOUND');var modelSet={};if(modelSheet)readAll_(modelSheet).forEach(function(r){var m=clean_(r.modelo||r.Modelo).toUpperCase();if(m)modelSet[m]=true;});var values=sh.getDataRange().getValues(),headers=(values[0]||[]).map(String),modelIndex=headers.findIndex(function(h){return clean_(h).toUpperCase()==='MODELO';});if(modelIndex<0)return fail_('No se encontró la columna MODELO en Stock.','COLUMN_NOT_FOUND');var removed=0;for(var i=values.length-1;i>=1;i--){if(modelSet[clean_(values[i][modelIndex]).toUpperCase()]){sh.getRange(i+1,1,1,sh.getLastColumn()).clearContent();removed++;}}clearLduReadCache_();return ok_({sheet:key,removed:removed},'Limpieza completada para '+(key==='STOCK_A'?'Stock Mod. A':'Stock Mod. B')+'.');}finally{try{lock.releaseLock();}catch(e){}}}
function clearSheetBase_(p){p=p||{};var key=String(p.sheetKey||'').toUpperCase(),allowed={INVENTORY:LDU.SHEETS.DEVICES,MODEL_A:LDU.SHEETS.MODELS_A,MODEL_B:LDU.SHEETS.MODELS_B,STOCK:LDU.SHEETS.STOCK,INCIDENTS:LDU.SHEETS.INCIDENTS,HISTORY:LDU.SHEETS.AUDIT,NOTIFICATIONS:LDU.SHEETS.NOTIFICATIONS},name=allowed[key];if(!name)return fail_('Hoja no autorizada para limpieza.','SHEET_NOT_ALLOWED');if(String(p.confirmation||'')!=='LIMPIAR '+key)return fail_('Confirmación de limpieza inválida.','CONFIRMATION_REQUIRED');if(String(p.userId||'').toLowerCase()!=='admin')return fail_('Solo el administrador puede ejecutar limpiezas.','ADMIN_REQUIRED');var lock=LockService.getScriptLock();try{lock.waitLock(30000);var ss=SpreadsheetApp.openById(LDU.SPREADSHEET_ID),sh=ss.getSheetByName(name);if(!sh)return fail_('La hoja configurada no existe: '+name,'SHEET_NOT_FOUND');var last=sh.getLastRow(),removed=Math.max(0,last-1);if(removed>0)sh.getRange(2,1,removed,sh.getLastColumn()).clearContent();clearLduReadCache_();return ok_({sheet:key,removed:removed},'Limpieza completada para '+name+'.');}finally{try{lock.releaseLock();}catch(e){}}}
