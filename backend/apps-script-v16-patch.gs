/* Autenticación: agrega password_hash a LDU_Usuarios si todavía no existe. */
function lduAuthHash_(p){var b=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(p||''),Utilities.Charset.UTF_8);return b.map(function(x){x=x<0?x+256:x;return('0'+x.toString(16)).slice(-2);}).join('');}
function lduAuthSheet_(){var ss=SpreadsheetApp.openById(LDU.SPREADSHEET_ID),sh=ss.getSheetByName(LDU.SHEETS.USERS)||ss.insertSheet(LDU.SHEETS.USERS),h=LDU.HEADERS[LDU.SHEETS.USERS].slice();if(h.indexOf('password_hash')<0)h.push('password_hash');if(sh.getLastRow()===0)sh.getRange(1,1,1,h.length).setValues([h]);else{var cur=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(String);h.forEach(function(x){if(cur.indexOf(x)<0)sh.getRange(1,sh.getLastColumn()+1).setValue(x);});}return sh;}
function ensureLduAdmin(){var sh=lduAuthSheet_(),v=sh.getDataRange().getValues(),h=v[0].map(String),u=h.indexOf('username'),ph=h.indexOf('password_hash'),a=h.indexOf('active'),row=-1;for(var i=1;i<v.length;i++)if(String(v[i][u]||'').toLowerCase()==='admin'){row=i+1;break;}if(row<0){var n=h.map(function(x){if(x==='user_id')return Utilities.getUuid();if(x==='username')return'admin';if(x==='role')return'Administrador';if(x==='name')return'Administrador LDU';if(x==='active')return'Sí';if(x==='password_hash')return lduAuthHash_('admin');if(x==='created_at'||x==='updated_at')return now_();return'';});sh.getRange(sh.getLastRow()+1,1,1,n.length).setValues([n]);return ok_({usuario:'admin'},'Administrador creado.');}if(ph>=0&&!v[row-1][ph])sh.getRange(row,ph+1).setValue(lduAuthHash_('admin'));if(a>=0&&!v[row-1][a])sh.getRange(row,a+1).setValue('Sí');return ok_({usuario:'admin'},'Administrador verificado.');}
function login(p){p=p||{};var sh=lduAuthSheet_(),v=sh.getDataRange().getValues(),h=v[0].map(String),u=h.indexOf('username'),ph=h.indexOf('password_hash'),ri=h.indexOf('role'),name=clean_(p.usuario||p.username).toLowerCase(),pass=lduAuthHash_(p.password||'');for(var i=1;i<v.length;i++)if(String(v[i][u]||'').toLowerCase()===name&&String(v[i][ph]||'')===pass){var t=Utilities.getUuid();PropertiesService.getScriptProperties().setProperty('LDU_SESSION_'+t,JSON.stringify({usuario:name,role:v[i][ri]||'Consulta'}));return ok_({usuario:name,role:v[i][ri]||'Consulta',token:t},'Inicio de sesión correcto.');}return fail_('Usuario o contraseña incorrectos.','AUTH_ERROR');}
