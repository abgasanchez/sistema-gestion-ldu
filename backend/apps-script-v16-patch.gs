function clearSheet(p){p=p||{};var key=String(p.sheetKey||'').toUpperCase(),allowed={INVENTORY:LDU.SHEETS.DEVICES,MODEL_A:LDU.SHEETS.MODELS_A,MODEL_B:LDU.SHEETS.MODELS_B,STOCK:LDU.SHEETS.STOCK,INCIDENTS:LDU.SHEETS.INCIDENTS,HISTORY:LDU.SHEETS.AUDIT,NOTIFICATIONS:LDU.SHEETS.NOTIFICATIONS},name=allowed[key];if(!name)return fail_('Hoja no autorizada para limpieza.','SHEET_NOT_ALLOWED');if(String(p.confirmation||'')!=='LIMPIAR '+key)return fail_('Confirmación de limpieza inválida.','CONFIRMATION_REQUIRED');if(String(p.userId||'').toLowerCase()!=='admin')return fail_('Solo el administrador puede ejecutar limpiezas.','ADMIN_REQUIRED');var lock=LockService.getScriptLock();try{lock.waitLock(30000);var ss=SpreadsheetApp.openById(LDU.SPREADSHEET_ID),sh=ss.getSheetByName(name);if(!sh)return fail_('La hoja configurada no existe: '+name,'SHEET_NOT_FOUND');var last=sh.getLastRow(),removed=Math.max(0,last-1);if(removed>0)sh.getRange(2,1,removed,sh.getLastColumn()).clearContent();clearLduReadCache_();return ok_({sheet:key,removed:removed},'Limpieza completada para '+name+'.');}finally{try{lock.releaseLock();}catch(e){}}}
function _lduNotificationSchema_(){
  var name=LDU.SHEETS.NOTIFICATIONS,ss=SpreadsheetApp.openById(LDU.SPREADSHEET_ID),sh=ss.getSheetByName(name)||ss.insertSheet(name),headers=['fecha','tipo','asunto','destinatario','zona','rol','correo','cc','remitente','estado'];
  LDU.HEADERS[name]=headers;
  if(sh.getLastRow()===0){sh.getRange(1,1,1,headers.length).setValues([headers]);sh.setFrozenRows(1);return sh;}
  var current=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(String);
  if(current.join('|')!==headers.join('|')){
    var old=sh.getDataRange().getValues(),oldHeaders=current;
    var migrated=[headers];
    for(var i=1;i<old.length;i++){
      var o=rowToObject_(old[i],oldHeaders),row={fecha:o.timestamp||o.fecha||'',tipo:o.type||o.tipo||'',asunto:o.subject||o.asunto||'',destinatario:o.recipient||o.destinatario||'',zona:o.zona||'',rol:o.role||o.rol||'',correo:o.email||o.correo||o.recipient||'',cc:o.cc||'',remitente:o.sender||o.created_by||o.remitente||'',estado:o.status||o.estado||''};
      migrated.push(objectToRow_(row,headers));
    }
    sh.clearContents();sh.getRange(1,1,migrated.length,headers.length).setValues(migrated);sh.setFrozenRows(1);
  }
  return sh;
}
function listNotifications(){
  _lduNotificationSchema_();
