}
function sendNotification(p){
  p=p||{};var n=p.notification||p,to=clean_(n.recipient||n.to||(n.recipients||[]).join(','));if(!to)throw new Error('Debe indicar al menos un destinatario.');
  _lduNotificationSchema_();var r={fecha:now_(),tipo:clean_(n.type||n.tipo||'General'),asunto:clean_(n.subject||n.asunto||'Notificación LDU'),destinatario:to,zona:clean_(n.zona),rol:clean_(n.rol||n.role),correo:clean_(n.email||to),cc:clean_(n.cc),remitente:clean_(n.sender||p.userId||'system'),estado:'Pendiente'};
